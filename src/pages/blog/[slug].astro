---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      relatedPosts: posts
        .filter(candidate => candidate.id !== post.id)
        .sort((a, b) => {
          const aSharedTags = a.data.tags.filter(tag => post.data.tags.includes(tag)).length;
          const bSharedTags = b.data.tags.filter(tag => post.data.tags.includes(tag)).length;
          return bSharedTags - aSharedTags || b.data.date.valueOf() - a.data.date.valueOf();
        })
        .slice(0, 3),
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);

// Estimate reading time (~200 words per minute)
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const siteURL = Astro.site ?? new URL('https://devproxy.net');
const postURL = new URL(Astro.url.pathname, siteURL).href;
const blogURL = new URL(`${import.meta.env.BASE_URL}blog/`, siteURL).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    image: post.data.image ? new URL(post.data.image, siteURL).href : undefined,
    mainEntityOfPage: postURL,
    publisher: {
      '@type': 'Organization',
      name: 'Dev Proxy',
      url: new URL(import.meta.env.BASE_URL, siteURL).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Blog',
        item: blogURL,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: post.data.title,
        item: postURL,
      },
    ],
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  ogType="article"
  structuredData={structuredData}
>
  <article class="pt-16 pb-24 px-4">
    <div class="max-w-3xl mx-auto">

      <!-- Back link -->
      <a href={`${import.meta.env.BASE_URL}blog/`} class="group inline-flex items-center gap-1.5 text-sm mb-10 transition-colors text-purple-400 hover:text-purple-300">
        <span class="inline-block transition-transform duration-200 group-hover:-translate-x-1">&larr;</span>
        <span>All posts</span>
      </a>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-center gap-2 mb-5">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-semibold tracking-wider uppercase px-3 py-1 rounded-full bg-purple-600/20 text-purple-400">{tag}</span>
          ))}
        </div>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight leading-[1.1] mb-6">{post.data.title}</h1>
        <div class="flex items-center gap-3 text-sm" style="color: var(--text-faint);">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>&middot;</span>
          <span>{post.data.author}</span>
          <span>&middot;</span>
          <span>{readingTime} min read</span>
        </div>
      </header>

      <!-- Hero image -->
      {post.data.image && (
        <div class="rounded-2xl overflow-hidden mb-12">
          <img src={post.data.image} alt="" class="w-full" />
        </div>
      )}

      <!-- Divider -->
      <div class="w-12 h-0.5 bg-purple-500/40 rounded mb-12"></div>

      <!-- Content -->
      <div class="prose-content">
        <Content />
      </div>

      <aside class="mt-16 pt-8 border-t" style="border-color: var(--border-primary);" aria-labelledby="related-posts-heading">
        <h2 id="related-posts-heading" class="text-xl font-bold mb-6">Related posts</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {relatedPosts.map(relatedPost => (
            <a
              href={`${import.meta.env.BASE_URL}blog/${relatedPost.id}/`}
              class="group block rounded-2xl border p-5 transition-all duration-300 hover:border-purple-500/50"
              style="background: var(--bg-secondary); border-color: var(--border-primary);"
            >
              <h3 class="font-semibold leading-snug group-hover:text-purple-400 transition-colors">
                {relatedPost.data.title}
              </h3>
              <time class="block text-xs mt-3" style="color: var(--text-faint);" datetime={relatedPost.data.date.toISOString()}>
                {relatedPost.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </aside>

      <!-- Post footer -->
      <footer class="mt-16 pt-8 border-t" style="border-color: var(--border-primary);">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <a href={`${import.meta.env.BASE_URL}blog/`} class="group inline-flex items-center gap-1.5 text-sm transition-colors text-purple-400 hover:text-purple-300">
            <span class="inline-block transition-transform duration-200 group-hover:-translate-x-1">&larr;</span>
            <span>All posts</span>
          </a>
          <a
            href="https://github.com/dotnet/dev-proxy"
            target="_blank"
            rel="noopener"
            class="text-sm transition-colors hover:text-purple-400"
            style="color: var(--text-faint);"
          >
            Star on GitHub &rarr;
          </a>
        </div>
      </footer>

    </div>
  </article>
</Layout>
